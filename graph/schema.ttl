@prefix ex: <http://example.org/univ#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:schema a owl:Ontology .

ex:Component a owl:Class .
ex:Manufacturer a owl:Class .
ex:Tier a owl:Class .
ex:Socket a owl:Class .
ex:Chipset a owl:Class .
ex:CPUFamily a owl:Class .
ex:MemoryType a owl:Class .
ex:StorageInterface a owl:Class .


ex:CPU a owl:Class ;
    rdfs:subClassOf ex:Component .

ex:RAM a owl:Class ;
    rdfs:subClassOf ex:Component .

ex:Motherboard a owl:Class ;
    rdfs:subClassOf ex:Component .

ex:Disk a owl:Class ;
    rdfs:subClassOf ex:Component .

ex:SSD a owl:Class ;
    rdfs:subClassOf ex:Disk .

ex:HDD a owl:Class ;
    rdfs:subClassOf ex:Disk .

ex:hasInterface a owl:ObjectProperty ;
    rdfs:domain ex:Disk ;
    rdfs:range ex:StorageInterface .

ex:hasDiskCapacityGB a owl:DatatypeProperty ;
    rdfs:domain ex:Disk ;
    rdfs:range xsd:decimal .

ex:hasBufferSizeMB a owl:DatatypeProperty ;
    rdfs:domain ex:Disk ;
    rdfs:range xsd:integer .

ex:hasWriteSpeedMBps a owl:DatatypeProperty ;
    rdfs:domain ex:Disk ;
    rdfs:range xsd:decimal .

ex:hasReadSpeedMBps a owl:DatatypeProperty ;
    rdfs:domain ex:Disk ;
    rdfs:range xsd:decimal .

ex:hasIOPS a owl:DatatypeProperty ;
    rdfs:domain ex:Disk ;
    rdfs:range xsd:integer .

ex:hasDriveSize a owl:DatatypeProperty ;
    rdfs:domain ex:Disk ;
    rdfs:range xsd:string .

ex:hasInstallationType a owl:DatatypeProperty ;
    rdfs:domain ex:Disk ;
    rdfs:range xsd:string ;
    rdfs:comment "Use internal or external." .

ex:isPortable a owl:DatatypeProperty ;
    rdfs:domain ex:Disk ;
    rdfs:range xsd:boolean .

ex:hasNANDType a owl:DatatypeProperty ;
    rdfs:domain ex:SSD ;
    rdfs:range xsd:string ;
    rdfs:comment "Supported values: SLC, MLC, TLC, QLC." .

ex:hasRPM a owl:DatatypeProperty ;
    rdfs:domain ex:HDD ;
    rdfs:range xsd:integer .

ex:usesSocket a owl:ObjectProperty ;
    rdfs:domain ex:CPU ;
    rdfs:range ex:Socket .


ex:hasChipset a owl:ObjectProperty ;
    rdfs:domain ex:Motherboard ;
    rdfs:range ex:Chipset .

ex:hasSocket a owl:ObjectProperty ;
    rdfs:domain ex:Motherboard ;
    rdfs:range ex:Socket .

ex:manufactures a owl:ObjectProperty ;
    rdfs:domain ex:Manufacturer ;
    rdfs:range ex:Component .

ex:manufacturesFamily a owl:ObjectProperty ;
    rdfs:domain ex:Manufacturer ;
    rdfs:range ex:CPUFamily .

ex:hasTier a owl:ObjectProperty ;
    rdfs:domain ex:Component ;
    rdfs:range ex:Tier .

ex:hasCores a owl:DatatypeProperty ;
    rdfs:domain ex:CPU ;
    rdfs:range xsd:integer .

ex:hasThreads a owl:DatatypeProperty ;
    rdfs:domain ex:CPU ;
    rdfs:range xsd:integer .

ex:hasTDP a owl:DatatypeProperty ;
    rdfs:domain ex:Component ;
    rdfs:range xsd:integer .

ex:hasMaxPower a owl:DatatypeProperty ;
    rdfs:domain ex:Component ;
    rdfs:range xsd:integer .

ex:hasBaseClock a owl:DatatypeProperty ;
    rdfs:domain ex:CPU ;
    rdfs:range xsd:decimal .

ex:hasBoostClock a owl:DatatypeProperty ;
    rdfs:domain ex:CPU ;
    rdfs:range xsd:decimal .

ex:hasIntegratedGraphics a owl:DatatypeProperty ;
    rdfs:domain ex:CPU ;
    rdfs:range xsd:boolean .

ex:belongsToFamily a owl:ObjectProperty ;
    rdfs:domain ex:CPU ;
    rdfs:range ex:CPUFamily .

ex:PSU a owl:Class ;
    rdfs:subClassOf ex:Component .

ex:Certification a owl:Class .

ex:hasCertification a owl:ObjectProperty ;
    rdfs:domain ex:PSU ;
    rdfs:range ex:Certification .

ex:hasPower a owl:DatatypeProperty ;
    rdfs:domain ex:PSU ;
    rdfs:range xsd:integer .

ex:hasPowerFactor a owl:DatatypeProperty ;
    rdfs:domain ex:PSU ;
    rdfs:range xsd:decimal .

ex:hasFormFactor a owl:DatatypeProperty ;
    rdfs:domain ex:Motherboard ;
    rdfs:range xsd:string .

ex:hasCapacityGB a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:integer .

ex:hasMemoryType a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:MemoryType .

ex:hasSpeedMTs a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:integer .

ex:hasFrequencyMHz a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:integer .

ex:hasCASLatency a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:integer .

ex:hasTimings a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:string .

ex:hasChannelMode a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:string .

ex:hasVoltage a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:decimal .

ex:hasECC a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:boolean .

ex:hasRegistered a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:boolean .

ex:hasHeatsink a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:boolean .

ex:hasXMPProfile a owl:DatatypeProperty ;
    rdfs:domain ex:RAM ;
    rdfs:range xsd:string .

ex:hasRAMArchitecture a owl:DatatypeProperty ;
    rdfs:domain ex:Motherboard ;
    rdfs:range xsd:string .

ex:hasRAMSlots a owl:DatatypeProperty ;
    rdfs:domain ex:Motherboard ;
    rdfs:range xsd:integer .

ex:hasPCIeSlots a owl:DatatypeProperty ;
    rdfs:domain ex:Motherboard ;
    rdfs:range xsd:string .

ex:hasM2Slots a owl:DatatypeProperty ;
    rdfs:domain ex:Motherboard ;
    rdfs:range xsd:string .

ex:hasSATAPorts a owl:DatatypeProperty ;
    rdfs:domain ex:Motherboard ;
    rdfs:range xsd:integer .
