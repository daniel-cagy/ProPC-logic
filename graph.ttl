@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:graph a owl:Ontology ;
    owl:imports ex:schema ,
                ex:catalog ,
                ex:cpus ,
                ex:relationships ,
                ex:motherboards ,
                ex:psus ,
                ex:chipsets .
